# Public build-time configuration. Vite inlines VITE_* variables into the bundle, so nothing
# secret may go here. An Entra SPA client ID and a tenant ID are public identifiers by design —
# they travel in every sign-in request — and a public client registration holds no secret.
#
# Override locally with .env.local (gitignored).

# Entra SPA app registration used to mint delegated Fabric tokens in the browser.
# EMPTY ON PURPOSE: the previous value (9a83b8b5-...) was `sp-agic-fabric-runtime-crm-agic-dev`,
# the CRM runtime service principal — it has no SPA redirect URI and no DataAgent permissions,
# so every sign-in failed. Fill this in once an admin creates the dedicated SPA registration
# described in the README, then redeploy (Vite inlines this at build time).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=d5e193bb-0b46-467d-9d95-03eb0d012c42

# Published Fabric data agent: `da_IP` in the "AGIC IP MARKETING - AGENT" workspace.
# NOT named VITE_FABRIC_*: `rayfin up` regenerates .env.local with VITE_FABRIC_WORKSPACE_ID
# pointing at this app's own workspace, and .env.local outranks .env in Vite.
VITE_DATA_AGENT_WORKSPACE_ID=f67f0cf4-b2c5-410e-b733-3b5c25b83ffd
VITE_DATA_AGENT_ID=c4a26507-3d2d-4f2f-9591-c88a013a1f22
