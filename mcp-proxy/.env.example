# Service principal with access to the "AGIC IP MARKETING - AGENT" workspace.
# Never commit the real .env file.
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# Defaults already point at the provided workspace/data agent; override only
# if you deploy against a different one.
FABRIC_WORKSPACE_ID=f67f0cf4-b2c5-410e-b733-3b5c25b83ffd
FABRIC_DATA_AGENT_ID=c4a26507-3d2d-4f2f-9591-c88a013a1f22

# JWKS endpoint of the deployed Rayfin app, used to verify caller session
# tokens. Confirm the exact path against the deployed app backend URL
# (e.g. https://<your-app>-app.rayfin.windows.net/auth/jwks).
RAYFIN_JWKS_URL=
RAYFIN_ISSUER=
RAYFIN_AUDIENCE=

# Origin of the deployed Fabric App (for CORS).
ALLOWED_ORIGIN=http://localhost:5173
